{
  "version": 2,
  "builds": [
    { "src": "send-lead.js", "use": "@vercel/node" },
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "*.js", "use": "@vercel/static" },
    { "src": "*.css", "use": "@vercel/static" },
    { "src": "*.svg", "use": "@vercel/static" },
    { "src": "*.png", "use": "@vercel/static" },
    { "src": "*.jpg", "use": "@vercel/static" },
    { "src": "*.jpeg", "use": "@vercel/static" },
    { "src": "*.pdf", "use": "@vercel/static" },
    { "src": "*.xml", "use": "@vercel/static" },
    { "src": "*.txt", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/send-lead", "dest": "/send-lead.js" },
    { "src": "/images/(.*)", "dest": "/$1" },
    { "src": "/files/(.*)", "dest": "/$1" },
    { "handle": "filesystem" },
    { "src": "/", "dest": "/index.html" }
  ]
}
